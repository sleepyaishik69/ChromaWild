# Ollama server reachable from the Next.js server.
OLLAMA_BASE_URL=http://localhost:11434

# Model used to generate color quests. Pull it with: ollama pull gemma2:2b
OLLAMA_MODEL=gemma2:2b

# Optional: enables Groq-backed field-note evaluation.
GROQ_API_KEY=

# Optional: enables ElevenLabs speech. Browser speech works without this.
ELEVENLABS_API_KEY=
